# Copy this file to .env and fill in real values. NEVER commit .env itself.

# --- Data source ---
# synthetic = deterministic fake data, works anywhere, for pipeline testing only.
# yahoo     = real historical data, needs normal outbound internet access.
# mt5       = Exness's own live/historical data via a running MT5 terminal.
FX_DATA_PROVIDER=synthetic

# Comma-separated pair universe (defaults to the 9 majors from the plan if unset)
# FX_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURJPY,GBPJPY

# --- Risk management ---
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MIN_RR_AFTER_COSTS=1.5
MAX_SPREAD_TO_STOP_RATIO=0.30
MAX_HOLDING_BARS=60

# --- Position sizing / account (see docs/RISK_MANAGEMENT.md) ---
ACCOUNT_CURRENCY=USD
ACCOUNT_STARTING_BALANCE=10000
DEFAULT_LEVERAGE=100
CONTRACT_SIZE=100000
MIN_LOT_STEP=0.01

# --- Exness / MT5 (see docs/EXNESS_INTEGRATION.md -- only usable on Windows/Wine) ---
EXNESS_MT5_LOGIN=
EXNESS_MT5_PASSWORD=
EXNESS_MT5_SERVER=
EXNESS_MT5_TERMINAL_PATH=

# --- Telegram (see docs/TELEGRAM.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
FX_DB_PATH=fx_engine.sqlite3

# --- Backtesting / validation ---
WALK_FORWARD_FOLDS=5
HOLDOUT_FRACTION=0.20
SLIPPAGE_PIPS=0.3
SWAP_PER_LOT_PER_DAY=0.0
